{
  "name": "aelux-components",
  "version": "0.1.0",
  "description": "Aelux Launcher 通用 UI 组件库 —— React + TypeScript，输出 ESM + d.ts，react/react-dom 为 peerDependencies，零运行时依赖。",
  "keywords": [
    "aelux",
    "react",
    "ui",
    "components",
    "component-library",
    "design-system",
    "vite"
  ],
  "author": "Aelux",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/aelux-components.js",
  "module": "./dist/aelux-components.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/aelux-components.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/aelux-components.js",
      "default": "./dist/aelux-components.js"
    },
    "./style.css": {
      "default": "./dist/aelux-components.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:showcase": "vite build --mode showcase",
    "preview": "vite preview --mode showcase",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
